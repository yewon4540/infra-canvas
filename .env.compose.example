# Copy to .env.compose.local (gitignored), protect it with chmod 600.
# Required for embedded PostgreSQL; use a generated URL-safe value.
POSTGRES_DB=eolgae
POSTGRES_USER=eolgae
POSTGRES_PASSWORD=
JWT_SECRET=
# false only for local HTTP. Use true behind production HTTPS.
COOKIE_SECURE=false
EOLGAE_BIND_ADDRESS=127.0.0.1
EOLGAE_HTTP_PORT=8080

# External PostgreSQL only: add compose.external-db.yml LAST.
# DATABASE_URL=postgresql+psycopg://user:encoded-password@db-host:5432/eolgae

# External Terrakube only: add compose.terrakube.yml.
# API URL includes /api/v1; UI URL is the web origin. No trailing slash needed.
TERRAKUBE_API_URL=
TERRAKUBE_UI_URL=
TERRAKUBE_ORGANIZATION_ID=
# Comma-separated UUIDs. Empty scopes deny access.
TERRAKUBE_WORKSPACE_IDS=
TERRAKUBE_USER_IDS=
# Absolute host path to a protected plain bearer-token file, not the token itself.
TERRAKUBE_TOKEN_FILE=

# Optional source credentials for STS Role verification / direct worker.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=ap-northeast-2
# EOLGAE_AWS_ACCOUNT_ID=
# CFN_TEMPLATE_URL=

# Standalone artifact settings; see compose.standalone.yml for optional S3 credentials.
# ARTIFACT_STORE_BACKEND=local
# ARTIFACT_S3_BUCKET=
# ARTIFACT_S3_PREFIX=artifacts
# ARTIFACT_S3_REGION=ap-northeast-2

# Optional Plan-only submission (off by default); dedicated user scope.
TERRAKUBE_PLAN_ENABLED=false
TERRAKUBE_PLAN_TEMPLATE_ID=
TERRAKUBE_PLAN_USER_IDS=

# Optional Kubernetes read profiles/credential directory; add compose.observation.yml.
# KUBERNETES_CONFIG_DIR=/absolute/private/kubernetes

# Eolgae 루트 환경변수 (.env 로 복사 후 값 채움)
#
# docker-compose.yml 의 ${VAR} 치환에 사용됨 + 각 컨테이너에 주입.
# FE 만의 변수 (NEXT_PUBLIC_*) 는 apps/web/.env.local 에 따로.

# ============================
# DB (PostgreSQL + pgvector)
# ============================
POSTGRES_DB=eolgae
POSTGRES_USER=eolgae
POSTGRES_PASSWORD=

# ============================
# Auth
# ============================
# 생성 명령: openssl rand -hex 32
JWT_SECRET=

# ============================
# LLM provider — 우선순위: Anthropic > OpenAI / OpenAI-compatible
# ============================
# 하나만 설정해도 동작. 둘 다 비우면 AI 피드백 요청 시 503 응답.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible endpoint (vLLM / Ollama / OpenRouter 등) 사용 시
# 예: Docker Desktop에서 호스트의 로컬 모델 서버 = http://host.docker.internal:11434/v1
# OPENAI_MODEL에는 연결한 서버가 제공하는 모델 ID를 설정한다.
# OPENAI_API_KEY 는 dummy 값 (예: "vllm") 이어도 OK
OPENAI_BASE_URL=
OPENAI_MODEL=

# ============================
# AWS (Cross-account Role assumption — Eolgae SaaS 측, [[004]])
# ============================
AWS_ACCOUNT_ID=
EXTERNAL_ID_SECRET=
EOLGAE_AWS_ACCOUNT_ID=
CFN_TEMPLATE_URL=

# Eolgae 서비스가 사용자 cross-account Role을 AssumeRole할 source credential.
# 운영 EC2에서는 instance profile 사용을 권장하므로 아래 값은 비워둠.
# 로컬 Docker Compose에서만 AWS profile의 임시 credential 등을 주입.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2

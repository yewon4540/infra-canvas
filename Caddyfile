# Local HTTP proxy. For TLS/domain setup, see docs/REVERSE-PROXY.md.
{
    auto_https off
}

:80 {
    redir /api /api/ 308
    handle_path /api/* {
        reverse_proxy api:8000 {
            # The API sets Path=/auth/refresh; browsers call /api/auth/refresh.
            header_down Set-Cookie "(?i)(;[ ]*Path=)/auth/refresh" "${1}/api/auth/refresh"
        }
    }
    handle {
        reverse_proxy web:3000
    }
}

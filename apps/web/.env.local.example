# Next.js 웹 환경변수 (apps/web/.env.local 로 복사 후 값 채움)
#
# Next.js 가 자동 로드. NEXT_PUBLIC_* 만 브라우저에 노출되고,
# 나머지는 server-side only.
#
# 로컬 개발: apps/web/.env.local (gitignore 됨)
# 배포: NEXT_PUBLIC_* 값은 빌드 시점에 결정됨. 로컬 .env 파일은 Docker context에서 제외.

# API 베이스 URL (FastAPI 직접 호출)
NEXT_PUBLIC_API_URL=http://localhost:8000

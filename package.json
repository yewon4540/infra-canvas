{
  "name": "eolgae",
  "version": "0.0.1",
  "private": true,
  "description": "Eolgae — GitOps for AWS Infrastructure",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.override.yml up",
    "down": "docker compose -f docker-compose.yml -f docker-compose.override.yml down",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
